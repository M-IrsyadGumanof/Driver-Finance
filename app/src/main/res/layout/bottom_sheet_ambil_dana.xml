<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_hero_card"
    android:backgroundTint="@color/surface">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_hero_card"
        android:backgroundTint="@color/card_border" />

    <!-- Judul Bottom Sheet -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_sheet_ambil_dana"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/subtitle_sheet_ambil_dana"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 1. Dropdown Jenis Tabungan -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilJenisTabungan"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/label_pilih_jenis_tabungan"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <AutoCompleteTextView
            android:id="@+id/actvJenisTabungan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Info Saldo Tersedia -->
    <TextView
        android:id="@+id/tvSaldoTersediaInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/savings_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Saldo tersedia: Rp150.000" />

    <!-- 2. Input Nominal Penarikan -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNominalAmbil"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nominal yang Diambil (Rp)"
        app:prefixText="Rp "
        app:prefixTextColor="@color/text_primary"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNominalAmbil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Dropdown Alasan Penarikan -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAlasan"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/label_alasan_ambil_dana"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <AutoCompleteTextView
            android:id="@+id/actvAlasan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 4. Catatan Tambahan (Opsional) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCatatanAmbil"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_catatan_alasan"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCatatanAmbil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Tombol Konfirmasi Ambil Dana -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKonfirmasiAmbil"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/btn_konfirmasi_ambil_dana"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/dana_ambil_btn"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_withdraw"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/on_primary" />

</LinearLayout>
