<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriverFinance">

        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.pemasukan.CatatPemasukanActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <activity
            android:name=".ui.pengeluaran.CatatPengeluaranActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

        <activity
            android:name=".ui.tabungan.TabunganActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.MainActivity" />

    </application>

</manifest>
